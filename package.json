{
  "name": "@aklinker1/check",
  "version": "3.0.1",
  "description": "Opinionated CLI that runs all your project's linters, formatters, and type checkers at once, with unified output.",
  "keywords": [
    "check",
    "eslint",
    "format",
    "lint",
    "oxfmt",
    "prettier",
    "publint",
    "typescript"
  ],
  "homepage": "https://github.com/aklinker1/check",
  "license": "MIT",
  "author": {
    "name": "Aaron Klinker",
    "email": "aaronklinker1+npm@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aklinker1/check.git"
  },
  "bin": {
    "check": "bin/check.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts && rm dist/cli.d.ts",
    "check": "bun src/cli.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.22.0",
    "publint": "^0.3.14",
    "tsdown": "^0.15.9",
    "typescript": "^7.0.2"
  }
}
